# Skopiuj ten plik do .env i uzupełnij wartości (plik .env NIE jest commitowany).
# Przy buildach EAS ustaw te same zmienne poleceniem: eas env:create

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google - DWA osobne klucze (Google Cloud Console -> APIs & Services -> Credentials):
# 1) Places API (zapytania HTTP z aplikacji). Ograniczenie aplikacji: BRAK,
#    ograniczenie API: tylko "Places API". (Ograniczenie "Android apps" blokuje zapytania HTTP!)
EXPO_PUBLIC_GOOGLE_API_KEY=
# 2) Natywna mapa. Ograniczenie aplikacji: "Android apps" (com.gabrynia67.destivo + SHA-1),
#    ograniczenie API: tylko "Maps SDK for Android". Bez prefiksu EXPO_PUBLIC_ (nie trafia do JS).
GOOGLE_MAPS_ANDROID_API_KEY=

# OpenWeatherMap API
EXPO_PUBLIC_WEATHER_API_KEY=

# Własne serwery OSRM (opcjonalne; domyślnie publiczne serwery OSRM)
EXPO_PUBLIC_OSRM_KRAKOW_BASE_URL=
EXPO_PUBLIC_OSRM_KRAKOW_FOOT_BASE_URL=
