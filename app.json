{
  "expo": {
    "name": "Destivo",
    "slug": "destivo",
    "scheme": "destivo",
    "version": "1.0.8",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gabrynia67.destivo",
      "versionCode": 9,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B1120"
      }
    },
    "extra": {
      "eas": {
        "projectId": "d3787a1f-ce03-4c9d-991d-b595d3d4e7c5"
      }
    },
    "sdkVersion": "54.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "Destivo używa lokalizacji, aby pokazać bilet, gdy jesteś w pobliżu miejsca odjazdu.",
          "locationAlwaysAndWhenInUsePermission": "Destivo może powiadomić Cię o bilecie, gdy dotrzesz na dworzec lub lotnisko, nawet przy zamkniętej aplikacji."
        }
      ],
      "expo-notifications"
    ]
  }
}
